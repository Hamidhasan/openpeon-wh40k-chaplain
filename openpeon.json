  "categories": {
    "session.start": {
      "sounds": [
        { "file": "sounds/ChaplainBuilt.wav", "label": "I am the Emperor's will made manifest." },
        { "file": "sounds/ChaplainSelect3.wav", "label": "Faith is purest when it is unquestioning." },
        { "file": "sounds/ChaplainSelect5.wav", "label": "Bless the mind too small for doubt." }
      ]
    },
    "task.acknowledge": {
      "sounds": [
        { "file": "sounds/ChaplainSelect1.wav", "label": "By the Emperor, it shall be so." },
        { "file": "sounds/ChaplainSelect2.wav", "label": "I accept the challenge." },
        { "file": "sounds/ChaplainMove3.wav", "label": "Difficult to be sure but it shall be done." },
        { "file": "sounds/ChaplainMove1.wav", "label": "May you lead us to victory." },
        { "file": "sounds/ChaplainMove2.wav", "label": "I shall rally the troops to your cause." }
      ]
    },
    "task.complete": {
      "sounds": [
        { "file": "sounds/ChaplainAttach2.wav", "label": "My brothers, we are together again." },
        { "file": "sounds/ChaplainAttach3.wav", "label": "None can match our combined might." },
        { "file": "sounds/ChaplainVictory3.wav", "label": "None can withstand our faith." },
        { "file": "sounds/ChaplainBattlecry1.wav", "label": "We live and die as brothers!" },
        { "file": "sounds/ChaplainVictory2.wav", "label": "May the Emperor watch over us all" }
      ]
    },
    "task.error": {
      "sounds": [
        { "file": "sounds/ChaplainMoraleBroken1.wav", "label": "We have been humbled." },
        { "file": "sounds/ChaplainMoraleBroken3.wav", "label": "Fall back, heed me, and regroup." },
        { "file": "sounds/ChaplainMoraleRecovered2.wav", "label": "Make your stand, here and now!" }
      ]
    },
    "task.progress": {
      "sounds": [
        { "file": "sounds/ChaplainCharge1.wav", "label": "For the glory of the Imperium, charge!" },
        { "file": "sounds/ChaplainCharge3.wav", "label": "Break the enemy line!" },
        { "file": "sounds/ChaplainBattlecry2.wav", "label": "Pain now, reward in the afterlife!" },
        { "file": "sounds/ChaplainAttack3.wav", "label": "Redeem them with sword and fire!" }
      ]
    },
    "input.required": {
      "sounds": [
        { "file": "sounds/ChaplainUnderAttack1.wav", "label": "Answer them, shot for shot." },
        { "file": "sounds/ChaplainUnderAttack3.wav", "label": "So, the enemy has some shred of courage." },
        { "file": "sounds/ChaplainVictory1.wav", "label": "Rally to me brothers, and we will win." }
      ]
    },
    "resource.limit": {
      "sounds": [
        { "file": "sounds/ChaplainDetach1.wav", "label": "I am needed elsewhere." },
        { "file": "sounds/ChaplainDetach3.wav", "label": "I must take my leave." }
      ]
    },
    "user.spam": {
      "sounds": [
        { "file": "sounds/ChaplainAttack2.wav", "label": "Drive them back." },
        { "file": "sounds/ChaplainUnderAttack2.wav", "label": "Their attacks are as weak as their faith!" },
        { "file": "sounds/ChaplainUnderAttack4.wav", "label": "How dare they fire upon the Emperor's chosen?" }
      ]
    },
    "session.end": {
      "sounds": [
        { "file": "sounds/ChaplainDetach2.wav", "label": "Remember what I have taught you." },
        { "file": "sounds/ChaplainDismount2.wav", "label": "So this is where the emperor's will brings us." },
        { "file": "sounds/ChaplainAttack4.wav", "label": "Only in war are we truly faithful." }
      ]
    }
